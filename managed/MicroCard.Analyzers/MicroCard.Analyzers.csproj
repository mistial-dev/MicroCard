<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <PackageId>MicroCard.Analyzers</PackageId>
    <PackageVersion>0.1.0-wip</PackageVersion>
    <PackageType>Analyzer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <Compile Include="../MicroCard.Build/VersionConstraint.cs" Link="VersionConstraint.cs" />
    <Compile Include="../MicroCard.Build/EmbeddedIdentifier.cs" Link="EmbeddedIdentifier.cs" />
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/MicroCard.Analyzers.props" Pack="true" PackagePath="buildTransitive" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
