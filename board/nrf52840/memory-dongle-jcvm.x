/* JCVM: separate image, metadata and authenticated applet heap regions. */
MEMORY {
 FLASH : ORIGIN = 0x00027000, LENGTH = 288K
 STAGING : ORIGIN = 0x0006F000, LENGTH = 64K
 IMAGES : ORIGIN = 0x0007F000, LENGTH = 128K
 HEAP0 : ORIGIN = 0x0009F000, LENGTH = 136K
 HEAP1 : ORIGIN = 0x000C1000, LENGTH = 136K
 JOURNAL0 : ORIGIN = 0x000E3000, LENGTH = 8K
 JOURNAL1 : ORIGIN = 0x000E5000, LENGTH = 8K
 KEYS : ORIGIN = 0x000E7000, LENGTH = 4K
 MONOTONIC : ORIGIN = 0x000E8000, LENGTH = 4K
 NONCES : ORIGIN = 0x000E9000, LENGTH = 4K
 RAM : ORIGIN = 0x20000000, LENGTH = 256K
}
_microcard_flash_origin = ORIGIN(FLASH);
