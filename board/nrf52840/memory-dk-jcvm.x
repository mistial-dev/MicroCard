/* JCVM: separate image, metadata and authenticated applet heap regions. */
MEMORY {
 FLASH : ORIGIN = 0x00000000, LENGTH = 512K
 STAGING : ORIGIN = 0x00080000, LENGTH = 64K
 IMAGES : ORIGIN = 0x00090000, LENGTH = 128K
 HEAP0 : ORIGIN = 0x000B0000, LENGTH = 136K
 HEAP1 : ORIGIN = 0x000D2000, LENGTH = 136K
 JOURNAL0 : ORIGIN = 0x000F4000, LENGTH = 8K
 JOURNAL1 : ORIGIN = 0x000F6000, LENGTH = 8K
 KEYS : ORIGIN = 0x000F8000, LENGTH = 4K
 MONOTONIC : ORIGIN = 0x000F9000, LENGTH = 4K
 NONCES : ORIGIN = 0x000FA000, LENGTH = 4K
 RAM : ORIGIN = 0x20000000, LENGTH = 256K
}
_microcard_flash_origin = ORIGIN(FLASH);
